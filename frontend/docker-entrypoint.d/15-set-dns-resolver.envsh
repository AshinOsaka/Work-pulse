#!/bin/sh
# Sourced by the nginx entrypoint (because of the .envsh extension) BEFORE 20-envsubst-on-templates.sh,
# so the export below reaches the template substitution.
#
# DNS_RESOLVER: nginx needs a working `resolver` to re-resolve the API upstream's hostname. Honour an explicit
# value (e.g. DNS_RESOLVER=8.8.8.8 when API_UPSTREAM is a public https URL whose name Render's internal
# resolver can't resolve); otherwise fall back to the container's own nameserver, which works under
# Docker/Compose (127.0.0.11) and resolves internal service names on hosts like Render.
# ${DNS_RESOLVER:-} so this is safe under the entrypoint's `set -u` (nounset) when the var is unset.
if [ -z "${DNS_RESOLVER:-}" ]; then
  r="$(awk '/^nameserver/ {print $2; exit}' /etc/resolv.conf 2>/dev/null)"
  [ -n "$r" ] && export DNS_RESOLVER="$r"
fi

# Host header for the proxied API. Default to nginx's own $host (single-origin behind a reverse proxy, and
# local Compose). Set API_HOST explicitly when API_UPSTREAM is a public URL so TLS/SNI and edge routing use
# the API's hostname. The value "$host" below is the literal nginx variable, left intact for envsubst.
export API_HOST="${API_HOST:-\$host}"
