#!/bin/sh
# Sourced by the nginx entrypoint (because of the .envsh extension) BEFORE 20-envsubst-on-templates.sh,
# so the export below reaches the template substitution.
#
# nginx needs a working `resolver` to re-resolve the API upstream's hostname at request time. The image
# defaults DNS_RESOLVER to Docker's embedded DNS (127.0.0.11), which exists only under Docker/Compose. On
# other platforms (e.g. Render) that address is unreachable and every /api request fails with 502. Using the
# container's actual nameserver from /etc/resolv.conf works everywhere (it is 127.0.0.11 under Docker anyway).
resolver="$(awk '/^nameserver/ {print $2; exit}' /etc/resolv.conf 2>/dev/null)"
if [ -n "$resolver" ]; then
  export DNS_RESOLVER="$resolver"
fi

# Host header for the proxied API. Default to nginx's own $host (single-origin behind a reverse proxy, and
# local Compose). Set API_HOST explicitly when API_UPSTREAM is a public URL so TLS/SNI and edge routing use
# the API's hostname. The value "$host" below is the literal nginx variable, left intact for envsubst.
export API_HOST="${API_HOST:-\$host}"
