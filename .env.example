# -----------------------------------------------------------------------------
# WorkPulse environment configuration
# Copy to `.env` and replace every value marked CHANGE_ME. Never commit `.env`.
# -----------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
# Public URL of the web app (used in password-reset / verification links).
# Testing through ngrok: set this to the ngrok HTTPS address (one tunnel to port 8080; see docs/ngrok.md).
FRONTEND_URL=http://localhost:8080
# Only needed when the frontend is served from a different origin than the API.
CORS_ORIGINS=

# --- Ports (docker compose) --------------------------------------------------
FRONTEND_PORT=8080
API_PORT=8000
MONGO_PORT=27017

# --- MongoDB -----------------------------------------------------------------
# Root account: used only by the database container itself.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=CHANGE_ME
# Least-privilege account the API connects with (created on first start).
# Use URL-safe characters (letters, digits, - _ .) in these passwords.
MONGO_APP_USERNAME=workpulse_app
MONGO_APP_PASSWORD=CHANGE_ME
MONGODB_DB=workpulse
# Connections per API process (total = processes x pool size, plus the worker).
MONGODB_MAX_POOL_SIZE=50
# Used when running the API outside Docker (docker compose overrides it):
MONGODB_URL=mongodb://workpulse_app:CHANGE_ME@localhost:27017/workpulse?authSource=workpulse

# --- Authentication ----------------------------------------------------------
# REQUIRED. At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
# Must be true in production (HTTPS). Browsers allow false for http://localhost.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# --- Screenshots / object storage ---------------------------------------------
# Screenshots are stored encrypted (AES-256-GCM) in a private volume, never in MongoDB documents.
# Optional in development, REQUIRED in production: base64 of 32 random bytes. When unset, a key is derived from
# JWT_SECRET (so rotating that secret would make screenshots unreadable). Generate with:
#   python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Changing it makes existing screenshots unreadable.
STORAGE_ENCRYPTION_KEY=
SCREENSHOT_URL_TTL_SECONDS=300

# --- Live screen viewing (WebRTC) ---------------------------------------------
# The API relays signalling only; video flows peer to peer. STUN (free, no account) is enough on the same network
# and through most NATs. TURN is optional: leave both TURN values empty and everything still works with STUN only.
# See docs/live-tracking.md.
LIVE_STUN_URLS=stun:stun.cloudflare.com:3478
# Optional, for viewers behind strict firewalls: a TURN server with a shared secret (e.g. coturn use-auth-secret).
LIVE_TURN_URLS=
LIVE_TURN_SECRET=

# --- E-mail ------------------------------------------------------------------
# console: e-mails are written to the API log (development only; refused in production).
# smtp:    delivered through your SMTP relay or provider.
EMAIL_BACKEND=console
EMAIL_FROM=WorkPulse <no-reply@workpulse.local>
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587) | ssl (port 465) | none (local relay only)
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Observability ------------------------------------------------------------
# Error tracking: exceptions and browser errors are sent to Sentry when a DSN is set.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Prometheus metrics at backend:8000/metrics (internal network only). Optional bearer token for scrapers.
METRICS_TOKEN=

# --- AI assistant (optional) -------------------------------------------------
# The assistant stays switched off until a key is set. Keep the key in .env or your secret store - never in code.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = more thorough, slower and costlier)
ASSISTANT_EFFORT=medium
# Questions each person can ask per hour.
ASSISTANT_QUESTIONS_PER_HOUR=60

# --- Abuse protection & sessions ---------------------------------------------
# Throttles sign-in, registration, password reset, e-mail links and agent sign-in (shared via MongoDB). Keep on.
RATE_LIMITS_ENABLED=true
# How often open browser WebSockets re-check that their sign-in session is still active (seconds).
SESSION_CHECK_SECONDS=15

# --- Redis --------------------------------------------------------------------
# Realtime events, live-viewing signalling and background-job leases are shared between API processes through Redis.
# REQUIRED with Docker Compose. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379
# Used when running the API outside Docker (Compose builds it from REDIS_PASSWORD). Leave empty for a single
# process without Redis (development only).
REDIS_URL=

# --- Scaling -------------------------------------------------------------------
# API processes in the backend container (they share realtime state through Redis). See docs/performance.md.
API_WORKERS=2
# Productivity cache refresh for recent days (seconds), done by the worker service.
PRODUCTIVITY_WARM_SECONDS=600
