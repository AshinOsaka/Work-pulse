# -----------------------------------------------------------------------------
# WorkPulse production configuration (docker-compose.yml + docker-compose.prod.yml)
#
#   cp .env.production.example .env      # on the server; then replace every CHANGE_ME
#   chmod 600 .env
#
# Never commit .env. Keep a copy of the secrets in your password manager or secret store: the database backup is
# useless without STORAGE_ENCRYPTION_KEY (screenshots) and JWT_SECRET (sessions).
# Generate random values with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"                                  (secrets, passwords)
#   python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"  (encryption key)
# The API refuses to start while a production setting is unsafe and lists what to fix (docker compose logs backend).
# -----------------------------------------------------------------------------

# --- Public address ---------------------------------------------------------------
# DNS name pointing at this server. Caddy obtains the HTTPS certificate for it automatically (ports 80 and 443 must
# be reachable from the internet).
DOMAIN=workpulse.example.com
# Certificate-expiry notices from Let's Encrypt.
ACME_EMAIL=ops@example.com
HTTP_PORT=80
HTTPS_PORT=443

# --- Application ---------------------------------------------------------------------
LOG_LEVEL=INFO
# API processes (about one per CPU core; see docs/performance.md).
API_WORKERS=4

# --- MongoDB -------------------------------------------------------------------------
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=CHANGE_ME
# Least-privilege account the API connects with. URL-safe characters only (letters, digits, - _ .).
MONGO_APP_USERNAME=workpulse_app
MONGO_APP_PASSWORD=CHANGE_ME
MONGODB_DB=workpulse
MONGODB_MAX_POOL_SIZE=50
# WiredTiger cache (GB). Roughly 40% of the memory you give MongoDB.
MONGO_CACHE_GB=1

# --- Redis ---------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME

# --- Authentication ------------------------------------------------------------------
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_SAMESITE=lax

# --- Screenshot encryption (REQUIRED) ----------------------------------------------------
# Changing or losing it makes every stored screenshot unreadable. Back it up separately from the data.
STORAGE_ENCRYPTION_KEY=CHANGE_ME
SCREENSHOT_URL_TTL_SECONDS=300

# --- E-mail (REQUIRED: password resets, invitations, verification) ------------------------
EMAIL_BACKEND=smtp
EMAIL_FROM=WorkPulse <no-reply@workpulse.example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME

# --- Live screen viewing (WebRTC) -----------------------------------------------------------
LIVE_STUN_URLS=stun:workpulse.example.com:3478
# TURN relay (the `turn` profile runs coturn on this server). Without TURN, live viewing only works when the
# manager's browser can reach the employee's computer directly (same network or VPN).
LIVE_TURN_URLS=turn:workpulse.example.com:3478?transport=udp,turn:workpulse.example.com:3478?transport=tcp
LIVE_TURN_SECRET=CHANGE_ME
# The server's public IP address (coturn advertises it in relay candidates).
TURN_EXTERNAL_IP=CHANGE_ME
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# --- Observability ---------------------------------------------------------------------------
# Optional Sentry project for error tracking (API, worker and browser errors).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Bearer token for Prometheus scrapes of backend:8000/metrics. Both that and the worker's metrics (worker:9101) are
# reachable only on the internal Docker network.
METRICS_TOKEN=

# --- AI assistant (optional) ------------------------------------------------------------------
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=medium
ASSISTANT_QUESTIONS_PER_HOUR=60

# --- Abuse protection & sessions ---------------------------------------------------------------
RATE_LIMITS_ENABLED=true
SESSION_CHECK_SECONDS=15
